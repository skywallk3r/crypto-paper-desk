# =============================================================================
# crypto-paper-desk — environment template
# Copy to .env and fill paper keys. NEVER commit real keys.
# =============================================================================

# --- Alpaca paper credentials (Dashboard → Paper Trading → API Keys) ---
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# MUST be true for this desk. Live trading is refused without explicit override.
ALPACA_PAPER=true

# Optional override of paper API host (defaults to paper URL when ALPACA_PAPER=true)
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Safety (defaults are the safe ones) ---
# Dry-run simulates orders and never hits submit_order. Default: true
DRY_RUN=true

# Live/real-money override — leave false forever unless you have explicit approval.
# Even if true, the broker adapter still refuses live orders unless an unsafe
# internal flag is set (the paper runner never sets it).
ALLOW_LIVE_TRADING=false

# --- Desk capital / risk ---
PAPER_CAPITAL_USD=10000
MAX_RISK_PER_TRADE_USD=200
DAILY_LOSS_KILL_PCT=0.02

# --- Symbol / cadence ---
SYMBOL=BTC/USD
BAR_TIMEFRAME=15Min
POLL_SECONDS=60

# --- Rank #1 strategy thresholds ---
LIQUIDATION_MIN_USD=1000000000
LIQUIDATION_LONG_PCT_MIN=0.80
FNG_MAX=30
RSI_OVERSOLD=30
ATR_PERIOD=14
ATR_STOP_MULT=1.5
CHASE_ATR_MULT=0.5
TARGET_R_MIN=1.0
TARGET_R_MAX=1.5
TIME_STOP_HOURS=4
WEEKEND_TIME_STOP_HOURS=3
WEEKEND_BOOK_FRACTION=0.60

# --- External adapters (optional; degrade gracefully if missing) ---
# CoinGlass API key — leave empty to skip liquidation gate (strategy will skip)
COINGLASS_API_KEY=
# COINGLASS_URL=https://open-api.coinglass.com/public/v2/liquidation_history

# Paper rehearsal without CoinGlass: inject a cascade snapshot
# LIQUIDATION_MANUAL_TOTAL_USD=1050000000
# LIQUIDATION_MANUAL_LONG_PCT=0.885

FEAR_GREED_URL=https://api.alternative.me/fng/?limit=1

# --- Journal ---
JOURNAL_BACKEND=sqlite
JOURNAL_PATH=journals/trades.db
# JOURNAL_BACKEND=csv
# JOURNAL_PATH=journals/trades.csv
